# Normalise line endings across the repo so a Windows checkout and a Linux CI
# runner produce identical bytes. Git stores LF in the repository; on checkout it
# is translated to the native ending unless a rule below says otherwise.
#
# Without this, the two-platform team sees a whole-file diff the first time a
# Windows-authored file is touched from Linux (or vice versa), which hides the
# one line that actually changed.
* text=auto eol=lf

# ── Explicit text types (diff-friendly, always LF) ───────────────────────────
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.prisma text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf

# ── Windows-only scripts must keep CRLF ──────────────────────────────────────
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ── Binary — never translated, never diffed line by line ─────────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.mp3    binary
*.mp4    binary

# ── Generated — collapse in diffs, exclude from language stats ───────────────
package-lock.json  -diff linguist-generated
*.tsbuildinfo      -diff linguist-generated
apps/api/prisma/migrations/** linguist-generated

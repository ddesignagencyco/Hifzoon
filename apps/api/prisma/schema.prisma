  classId      String   @map("class_id") @db.Uuid
  lessonCardId String?  @map("lesson_card_id") @db.Uuid
  familyUserId String   @map("family_user_id") @db.Uuid
  studentId    String?  @map("student_id") @db.Uuid
  stars        Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  class      ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonCard LessonCard?  @relation(fields: [lessonCardId], references: [id], onDelete: SetNull)

model Streak {
  id             String    @id @default(uuid(7)) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  currentLength  Int       @default(0) @map("current_length")
  longestLength  Int       @default(0) @map("longest_length")
  lastActivityOn DateTime? @map("last_activity_on") @db.Date

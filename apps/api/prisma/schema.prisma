  student    Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([classId, familyUserId])
  @@index([lessonCardId])
  @@map("class_review")
}

model QaRubric {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(120)
  criteria  Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviews QaReview[]

  @@map("qa_rubric")
}

model QaReview {
  id           String         @id @default(uuid(7)) @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  supervisorId String         @map("supervisor_id") @db.Uuid
  rubricId     String         @map("rubric_id") @db.Uuid
  scores       Json
  feedback     String?        @db.Text
  teacherReply String?        @map("teacher_reply") @db.Text
  reviewedAt   DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  source       QaSampleSource @default(MANUAL)

  class      ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  supervisor User         @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  rubric     QaRubric     @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  @@unique([classId, supervisorId])
  @@index([supervisorId, reviewedAt])
  @@map("qa_review")
}

model QaSample {
  id        String         @id @default(uuid(7)) @db.Uuid
  teacherId String         @map("teacher_id") @db.Uuid
  classId   String         @map("class_id") @db.Uuid
  period    String         @db.VarChar(7)
  source    QaSampleSource @default(RANDOM_SAMPLE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   ClassSession   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([period, classId])
  @@index([teacherId, period])
  @@map("qa_sample")
}

model CaseRecord {
  id            String     @id @default(uuid(7)) @db.Uuid
  type          CaseType
  status        CaseStatus @default(OPEN)
  ownerId       String?    @map("owner_id") @db.Uuid
  openedById    String     @map("opened_by") @db.Uuid
  subjectUserId String?    @map("subject_user_id") @db.Uuid
  classId       String?    @map("class_id") @db.Uuid
  summary       String     @db.Text
  dueAt         DateTime   @map("due_at") @db.Timestamptz(6)
  alertedAt     DateTime?  @map("alerted_at") @db.Timestamptz(6)
  closedAt      DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User?         @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  openedBy User          @relation("CaseOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  class    ClassSession? @relation(fields: [classId], references: [id], onDelete: SetNull)
  notes    CaseNote[]

  @@index([type, status])
  @@index([ownerId, status])
  @@index([dueAt])
  @@map("case_record")
}

model CaseNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  caseRecord CaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("case_note")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2.12 CRM and operations (OPS)
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(uuid(7)) @db.Uuid
  source         String?    @db.VarChar(60)
  status         LeadStatus @default(NEW)
  ownerId        String?    @map("owner_id") @db.Uuid
  contactName    String     @map("contact_name") @db.VarChar(160)
  email          String?    @db.VarChar(320)
  phone          String?    @db.VarChar(32)
  country        String?    @db.VarChar(2)
  childAge       Int?       @map("child_age")
  courseInterest String?    @map("course_interest") @db.VarChar(60)
  familyId       String?    @map("family_id") @db.Uuid
  trialClassId   String?    @map("trial_class_id") @db.Uuid
  lostReason     String?    @map("lost_reason") @db.Text
  notes          String?    @db.Text
  /// CR-02 — leads that never convert are swept after 12 months.
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User?              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contactUser   User?              @relation("LeadContact", fields: [contactUserId], references: [id], onDelete: SetNull)
  contactUserId String?            @map("contact_user_id") @db.Uuid
  family        Family?            @relation("LeadConvertedFamily", fields: [familyId], references: [id], onDelete: SetNull)
  tasks         Task[]
  conversations ChatConversation[]

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@map("lead")
}

model Task {
  id          String     @id @default(uuid(7)) @db.Uuid
  leadId      String?    @map("lead_id") @db.Uuid
  type        TaskType
  assigneeId  String?    @map("assignee_id") @db.Uuid
  dueAt       DateTime   @map("due_at") @db.Timestamptz(6)
  status      TaskStatus @default(OPEN)
  note        String?    @db.Text
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  lead     Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@map("task")
}

model TrialOutcome {
  id                String   @id @default(uuid(7)) @db.Uuid
  classId           String   @unique @map("class_id") @db.Uuid
  placementLevelId  String?  @map("placement_level_id") @db.Uuid
  recommendedPlanId String?  @map("recommended_plan_id") @db.Uuid
  notes             String?  @db.Text
  subscribeToken    String   @unique @map("subscribe_token") @db.VarChar(64)
  completedAt       DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  class           ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  placementLevel  CourseLevel? @relation(fields: [placementLevelId], references: [id], onDelete: SetNull)
  recommendedPlan Plan?        @relation(fields: [recommendedPlanId], references: [id], onDelete: SetNull)

  @@map("trial_outcome")
}

model AppSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("app_setting")
}

model RolePermission {
  id         String   @id @default(uuid(7)) @db.Uuid
  role       Role
  permission String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([role, permission])
  @@map("role_permission")
}

/// FR-OPS-06 — append-only. No `@updatedAt`; UPDATE/DELETE are blocked by a trigger in
/// the migration, and the app DB role is granted no UPDATE/DELETE privilege.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  targetType String?  @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.VarChar(80)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  requestId  String?  @map("request_id") @db.VarChar(80)
  at         DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, at])
  @@index([targetType, targetId])
  @@index([at])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2.13 Messaging, notifications and engagement
// ─────────────────────────────────────────────────────────────────────────────

model MessageThread {
  id          String   @id @default(uuid(7)) @db.Uuid
  familyId    String   @map("family_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  studentId   String?  @map("student_id") @db.Uuid
  enrolmentId String?  @map("enrolment_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrolment Enrolment?     @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([familyId, updatedAt])
  @@index([teacherId, updatedAt])
  @@map("message_thread")
}

model Message {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@map("message")
}

model NotificationPreference {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  email     Boolean   @default(true)
  whatsapp  Boolean   @default(false)
  push      Boolean   @default(true)
  quietFrom DateTime? @map("quiet_from") @db.Time
  quietTo   DateTime? @map("quiet_to") @db.Time
  language  String    @default("en") @db.VarChar(5)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          String              @db.VarChar(80)
  channel       NotificationChannel
  payload       Json
  status        NotificationStatus  @default(QUEUED)
  scheduledFor  DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  /// The id the provider returned for this send. The delivery webhook addresses
  /// messages by this, so an update naming a message we have no row for is not an
  /// error — it is a send this deployment never made.
  providerMessageId String?         @map("provider_message_id") @db.VarChar(255)
  failureReason String?             @map("failure_reason") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, scheduledFor])
  @@index([providerMessageId])
  @@map("notification")
}

model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  platform  DevicePlatform
  token     String         @unique @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}

model Badge {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  students StudentBadge[]

  @@map("badge")
}

model StudentBadge {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@map("student_badge")

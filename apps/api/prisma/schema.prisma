// Hifzoon database schema.
//
// Source of truth: docs/Hifzoon-ERD.md (sections 2.1 - 2.14) and the constraints in
// section 3. Conventions follow TRD section 11:
//   * snake_case tables/columns (@map / @@map), UUID v7 primary keys
//   * timestamptz(6) everywhere, stored UTC (FR-SCH-01, FR-SCH-02)
//   * money as integer minor units (ERD section 3)
//   * JSONB for rubric/config payloads
//
// Constraints Prisma cannot express (GiST exclusion ranges, triggers, RLS, append-only
// audit_log, cross-column CHECKs) live in prisma/migrations/*/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


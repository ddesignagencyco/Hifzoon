model PracticeAssignment {
  id            String                   @id @default(uuid(7)) @db.Uuid
  studentId     String                   @map("student_id") @db.Uuid
  teacherId     String                   @map("teacher_id") @db.Uuid
  fromSurah     Int                      @map("from_surah")
  fromAyah      Int                      @map("from_ayah")
  toSurah       Int                      @map("to_surah")
  toAyah        Int                      @map("to_ayah")
  mode          PracticeMode
  targetMinutes Int                      @map("target_minutes")
  dueOn         DateTime?                @map("due_on") @db.Date
  status        PracticeAssignmentStatus @default(ASSIGNED)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher  TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sessions PracticeSession[]

  @@index([studentId, status])
  @@map("practice_assignment")
}

model PracticeSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  assignmentId     String?   @map("assignment_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  minutes          Int       @default(0)
  wordsRecited     Int       @default(0) @map("words_recited")
  revealsCount     Int       @default(0) @map("reveals_count")
  audioKey         String?   @map("audio_key") @db.Text
  /// CR-02 — 30 day audio retention; derived results are kept.
  audioDeleteAfter DateTime? @map("audio_delete_after") @db.Timestamptz(6)
  resultSummary    Json?     @map("result_summary")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  assignment PracticeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mistakes   Mistake[]

  @@index([studentId, startedAt])
  @@index([audioDeleteAfter])
  @@map("practice_session")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2.10 Billing and payroll (BIL)
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id             String        @id @default(uuid(7)) @db.Uuid
  code           String        @unique @db.VarChar(40)
  name           String        @db.VarChar(120)
  classesPerWeek Int           @map("classes_per_week")
  classMinutes   Int           @map("class_minutes")
  roomType       RoomType      @default(ONE_TO_ONE) @map("room_type")
  billingPeriod  BillingPeriod @default(MONTHLY) @map("billing_period")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices        PlanPrice[]
  subscriptions Subscription[]
  trialOutcomes TrialOutcome[]

  @@map("plan")
}

model PlanPrice {
  id          String   @id @default(uuid(7)) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  currency    Currency
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
  @@map("plan_price")
}

model DiscountRule {
  id        String       @id @default(uuid(7)) @db.Uuid
  type      DiscountType
  name      String       @db.VarChar(120)
  config    Json
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("discount_rule")
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  familyId               String             @map("family_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  currency               Currency
  status                 SubscriptionStatus @default(TRIALING)
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(255)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  pausedUntil            DateTime?          @map("paused_until") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices   Invoice[]
  enrolments Enrolment[]

  @@index([familyId, status])
  @@index([status])
  @@map("subscription")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  familyId       String        @map("family_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  number         String        @unique @db.VarChar(40)
  currency       Currency
  subtotalMinor  Int           @map("subtotal_minor")
  discountMinor  Int           @default(0) @map("discount_minor")
  totalMinor     Int           @map("total_minor")
  status         InvoiceStatus @default(DRAFT)
  dueAt          DateTime      @map("due_at") @db.Timestamptz(6)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  pdfUrl         String?       @map("pdf_url") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([familyId, status])
  @@index([status, dueAt])
  @@map("invoice")
}

model Payment {
  id                String              @id @default(uuid(7)) @db.Uuid
  invoiceId         String              @map("invoice_id") @db.Uuid
  provider          PaymentProviderCode
  providerPaymentId String              @unique @map("provider_payment_id") @db.VarChar(255)
  method            PaymentMethod
  amountMinor       Int                 @map("amount_minor")
  currency          Currency
  status            PaymentStatus       @default(PENDING)
  attempt           Int                 @default(1)
  nextRetryAt       DateTime?           @map("next_retry_at") @db.Timestamptz(6)
  failureReason     String?             @map("failure_reason") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([invoiceId])
  @@index([status, nextRetryAt])
  @@map("payment")
}

model Refund {
  id          String   @id @default(uuid(7)) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amountMinor Int      @map("amount_minor")
  reason      String   @db.Text
  issuedById  String   @map("issued_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refund")
}

model ClassCredit {
  id            String   @id @default(uuid(7)) @db.Uuid
  familyId      String   @map("family_id") @db.Uuid
  amountClasses Int      @map("amount_classes")
  reason        String   @db.Text
  issuedById    String   @map("issued_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("class_credit")
}

model Sponsorship {
  id          String            @id @default(uuid(7)) @db.Uuid
  donorUserId String            @map("donor_user_id") @db.Uuid
  studentId   String?           @map("student_id") @db.Uuid
  status      SponsorshipStatus @default(ACTIVE)
  startedOn   DateTime          @map("started_on") @db.Date
  endedOn     DateTime?         @map("ended_on") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  donorUser User @relation(fields: [donorUserId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("sponsorship")
}

model PayRate {
  id                String     @id @default(uuid(7)) @db.Uuid
  name              String     @db.VarChar(120)
  currency          Currency
  ratePerClassMinor Int        @map("rate_per_class_minor")
  classType         ClassType? @map("class_type")
  effectiveFrom     DateTime   @map("effective_from") @db.Date
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  teachers TeacherProfile[]

  @@map("pay_rate")
}

model PayrollPeriod {
  id        String              @id @default(uuid(7)) @db.Uuid
  startsOn  DateTime            @map("starts_on") @db.Date
  endsOn    DateTime            @map("ends_on") @db.Date
  status    PayrollPeriodStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries PayrollEntry[]

  @@unique([startsOn, endsOn])
  @@map("payroll_period")
}

model PayrollEntry {
  id              String              @id @default(uuid(7)) @db.Uuid
  periodId        String              @map("period_id") @db.Uuid
  teacherId       String              @map("teacher_id") @db.Uuid
  grossMinor      Int                 @default(0) @map("gross_minor")
  deductionsMinor Int                 @default(0) @map("deductions_minor")
  bonusesMinor    Int                 @default(0) @map("bonuses_minor")
  netMinor        Int                 @default(0) @map("net_minor")
  status          PayrollPeriodStatus @default(OPEN)
  paidAt          DateTime?           @map("paid_at") @db.Timestamptz(6)
  payoutReference String?             @map("payout_reference") @db.VarChar(120)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  period  PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  lines   PayrollLine[]

  @@unique([periodId, teacherId])
  @@index([teacherId])
  @@map("payroll_entry")
}

model PayrollLine {
  id          String          @id @default(uuid(7)) @db.Uuid
  entryId     String          @map("entry_id") @db.Uuid
  classId     String?         @map("class_id") @db.Uuid
  teacherId   String?         @map("teacher_id") @db.Uuid
  kind        PayrollLineKind
  amountMinor Int             @map("amount_minor")
  note        String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  entry   PayrollEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  class   ClassSession?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([classId])
  @@map("payroll_line")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2.11 Quality, cases and safeguarding (QA)

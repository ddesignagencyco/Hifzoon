  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])
  @@map("streak")
}

model StickerAward {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  sticker   String   @db.VarChar(60)
  note      String?  @db.Text
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, awardedAt])
  @@map("sticker_award")
}

model Referral {
  id               String   @id @default(uuid(7)) @db.Uuid
  code             String   @unique @db.VarChar(24)
  referrerFamilyId String   @map("referrer_family_id") @db.Uuid
  newFamilyId      String?  @map("new_family_id") @db.Uuid
  rewardApplied    Boolean  @default(false) @map("reward_applied")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referrerFamily Family  @relation("ReferralReferrer", fields: [referrerFamilyId], references: [id], onDelete: Cascade)
  newFamily      Family? @relation("ReferralNewFamily", fields: [newFamilyId], references: [id], onDelete: SetNull)

  @@index([referrerFamilyId])
  @@map("referral")
}

model PersonalGoal {
  id         String    @id @default(uuid(7)) @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  title      String    @db.VarChar(200)
  dueOn      DateTime? @map("due_on") @db.Date
  achievedAt DateTime? @map("achieved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("personal_goal")
}

model AyahNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  surah     Int
  ayah      Int
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, surah, ayah])
  @@map("ayah_note")
}

model VocabCard {
  id        String    @id @default(uuid(7)) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  word      String    @db.VarChar(120)
  meaning   String    @db.Text
  surah     Int?
  ayah      Int?
  box       Int       @default(1)
  nextDueAt DateTime? @map("next_due_at") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, nextDueAt])
  @@map("vocab_card")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2.14 Content cache (CR-11)
// ─────────────────────────────────────────────────────────────────────────────

/// Licensed Quran content cache. `expires_at` is capped at 7 days by a CHECK constraint
/// because the licence (Quran Foundation terms) forbids longer retention.
model ContentCache {
  key       String   @id @db.VarChar(255)
  value     Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("content_cache")
}

/// Optional local layout index, only populated if the licence allows storing it.
model MushafLayoutRef {
  id        String       @id @default(uuid(7)) @db.Uuid
  layout    MushafLayout
  page      Int
  surah     Int
  ayahFrom  Int          @map("ayah_from")
  ayahTo    Int          @map("ayah_to")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([layout, page])
  @@index([surah])
  @@map("mushaf_layout_ref")
}

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Number of reverse-proxy hops to trust for X-Forwarded-For. 0 locally; set 1 on a
# managed platform (Render, Fly, Heroku) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Comma-separated list; CORS_ORIGINS=* is allowed only in development.
CORS_ORIGINS=http://localhost:3000
# Web origin for links in emails/WhatsApp (reminder join links). Local dev.
APP_WEB_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hifzoon:hifzoon@localhost:5432/hifzoon?schema=public

# ── Redis / queues ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ── Tokens (NFR-SEC-01: secrets from env only, never committed) ──────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-1111111111111111
JWT_ACCESS_TTL=15m
JWT_ISSUER=hifzoon-api
JWT_AUDIENCE=hifzoon-web
# Used to derive the 2FA encryption key (AES-256-GCM) via HKDF.
TWO_FACTOR_ENCRYPTION_KEY=dev-only-2fa-key-change-me-22222222222222222
# Used to hash refresh tokens and reset tokens (HMAC pepper).
TOKEN_PEPPER=dev-only-token-pepper-change-me-3333333333333
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── OAuth (optional in development; required for FR-AUTH-01) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Storage (PLAT-BE-06) ─────────────────────────────────────────────────
# Cloudinary holds every uploaded file: recitation audio, application documents,
# avatars, and data-export JSON. Assets are uploaded as `authenticated`, so they are
# only readable through short-lived signed URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Class recording is optional and needs a separate S3-compatible bucket: LiveKit Egress
# cannot write to Cloudinary. Leave these empty to disable recording; the rest of the app
# still uses Cloudinary. (The docker-compose MinIO service can fill these locally.)
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_REGION=us-east-1
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY=
RECORDING_STORAGE_SECRET_KEY=
RECORDING_STORAGE_FORCE_PATH_STYLE=true

# ── Observability (PLAT-BE-05) ───────────────────────────────────────────
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Integrations (PLAT-BE-07). Selects the adapter; "fake" keeps tests hermetic.
# fake | livekit. LiveKit is open source and self-hostable (docker compose service `livekit`);
# the same adapter works against LiveKit Cloud. Recording needs the `recording` compose profile.
VIDEO_PROVIDER=fake
# fake | stripe. UK operating country: stripe, billed in GBP (STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET are then required; point Stripe's webhook at POST /api/v1/webhooks/payments).
PAYMENT_PROVIDER=fake
# log | file | smtp | resend. `file` writes .eml to MAIL_CAPTURE_DIR; `smtp` talks to any
# SMTP server, which is how the compose MailHog service is used (UI :8025, SMTP :1025).
MAIL_PROVIDER=smtp
MAIL_FROM=Hifzoon <no-reply@hifzoon.test>
MAIL_CAPTURE_DIR=tmp/mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Disables TLS certificate verification. Local relays do not need it; leave it off
# anywhere that verifies a certificate.
SMTP_ALLOW_UNTRUSTED=false
WHATSAPP_PROVIDER=fake
QURAN_CONTENT_PROVIDER=fake
SPEECH_PROVIDER=fake

# Where the API reaches LiveKit (inside Docker: http://livekit:7880).
LIVEKIT_URL=
# What a browser connects to (defaults to LIVEKIT_URL), e.g. ws://localhost:7880.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
QURAN_CONTENT_API_KEY=
SPEECH_API_KEY=
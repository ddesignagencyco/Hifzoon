# Copy to .env.local.
# Local dev: the API from `docker compose up` (or `npm run dev --workspace @hifzoon/api`).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Subscriptions, checkout, invoices, refunds and dunning. Leave false until a payment
# provider is integrated: the parent Billing page shows a "not available yet" notice and the
# admin Billing console is hidden. Only the exact string "true" turns billing on.
NEXT_PUBLIC_BILLING_ENABLED=false
